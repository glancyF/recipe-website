DirectoryIndex index.php
Options -MultiViews

RewriteEngine On

RewriteRule ^(.+)\.(?:css|js|mjs|map|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|eot)$ - [L]


RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]


<IfModule mod_headers.c>
  Header edit Location "^/(?!~desheval/)(.*)$" "/~desheval/$1"
</IfModule>
